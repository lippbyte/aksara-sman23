# Salin ke .env lalu isi nilainya. Jangan commit .env.

# Aplikasi
NODE_ENV=
API_PORT=
APP_ORIGIN=
SESSION_SECRET=
VITE_APP_NAME=

# MySQL (docker compose + Prisma)
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
# Basis data uji end-to-end (Playwright); nama wajib berakhiran _e2e
E2E_DATABASE_URL=

# Kata sandi akun contoh (dipakai seeder, data fiktif)
SEED_PASSWORD=

# Opsional: folder berkas unggahan (logo & latar sekolah, di luar git)
UPLOAD_DIR=

# Opsional: fatal, error, warn, info, debug, silent
LOG_LEVEL=
